
<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="LINCEINTUITIVO — Mobiliário, decoração, design de interiores e projetos de espaços exclusivos.">
<title>LINCEINTUITIVO | Interiores de Assinatura</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Italiana&display=swap" rel="stylesheet">

<style>
:root{
  --black:#090909;
  --gold:#c5a46a;
  --white:#f8f7f4;
  --grey:#aaa8a3;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--black);color:white;font-family:'DM Sans',sans-serif;font-weight:300}
a{text-decoration:none;color:inherit}
h1,h2,h3,p{margin-top:0}
img{display:block;width:100%;height:100%;object-fit:cover}
.serif{font-family:'Italiana',serif;font-weight:400}
.gold{color:var(--gold)}
.section{padding:110px 8%}
.eyebrow{font-size:10px;letter-spacing:4px;text-transform:uppercase;color:var(--gold)}
h2{font-size:clamp(36px,5vw,75px);font-weight:400;line-height:1.1}
p{line-height:1.8}
.small-text{font-size:14px;color:#aaa;max-width:480px}
.btn{display:inline-block;border:1px solid var(--gold);color:var(--gold);padding:17px 32px;font-size:11px;letter-spacing:2px;text-transform:uppercase;transition:.3s}
.btn:hover{background:var(--gold);color:#111}
.btn.dark{color:#111;border-color:#111}
.btn.dark:hover{background:#111;color:white}

/* HEADER */
header{
position:absolute;top:0;left:0;width:100%;z-index:20;
display:flex;justify-content:space-between;align-items:center;
padding:32px 7%;border-bottom:1px solid #ffffff25;
}
.logo{font-family:'Italiana',serif;font-size:27px;letter-spacing:3px}
.logo span{color:var(--gold)}
nav{display:flex;gap:32px;align-items:center}
nav a{font-size:11px;letter-spacing:2px;text-transform:uppercase;transition:.3s}
nav a:hover{color:var(--gold)}
.menu-btn{display:none;background:none;border:none;color:white;font-size:26px;cursor:pointer}

/* HERO */
.hero{height:100vh;min-height:650px;position:relative;display:flex;align-items:center;padding:0 8%}
.hero::before{
content:"";position:absolute;inset:0;
background:linear-gradient(90deg,rgba(0,0,0,.78),rgba(0,0,0,.10)),linear-gradient(0deg,#0007,transparent 45%);
z-index:1;
}
.hero-bg{position:absolute;inset:0;background-image:url('https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2000&q=85');background-size:cover;background-position:center}
.hero-content{position:relative;z-index:2;max-width:850px}
.hero h1{font-size:clamp(64px,9vw,145px);line-height:.95;margin:27px 0 35px}
.hero-sub{letter-spacing:3px;font-size:12px;margin-bottom:45px;color:#eee}
.hero-bottom{position:absolute;z-index:3;bottom:35px;left:8%;right:8%;display:flex;justify-content:space-between;font-size:10px;letter-spacing:3px;color:#ddd}

/* INTRO */
.intro{text-align:center;background:var(--white);color:#151515}
.intro h2{max-width:1000px;margin:25px auto 30px}
.intro p{max-width:540px;margin:auto;color:#777;font-size:14px}
.intro .line{width:1px;height:75px;background:var(--gold);margin:45px auto 0}

/* COLLECTIONS */
.section-heading{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:55px}
.section-heading h2{margin:15px 0 0}
.collection-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:22px}
.collection-card{position:relative;overflow:hidden}
.collection-card .photo{height:480px;overflow:hidden}
.collection-card img{transition:transform .7s}
.collection-card:hover img{transform:scale(1.06)}
.collection-card h3{font-family:'Italiana',serif;font-size:33px;font-weight:400;margin:22px 0 5px}
.collection-card p{font-size:11px;color:var(--gold);letter-spacing:2px;text-transform:uppercase}

/* FEATURE */
.feature{display:grid;grid-template-columns:1fr 1fr;background:#141414}
.feature-image{min-height:680px}
.feature-content{padding:100px 12%;display:flex;flex-direction:column;justify-content:center}
.feature-content h2{margin:25px 0}
.feature-content .btn{align-self:flex-start;margin-top:28px}

/* SERVICES */
.services{background:var(--white);color:#111}
.service-grid{margin-top:60px}
.service{
display:grid;grid-template-columns:75px 1fr 35px;align-items:center;
border-bottom:1px solid #ddd;padding:26px 0;gap:20px;
}
.service:first-child{border-top:1px solid #ddd}
.service .num{font-size:12px;color:#a88a58}
.service h3{font-family:'Italiana',serif;font-weight:400;font-size:clamp(26px,3vw,43px);margin:0}
.service .arrow{font-size:23px;color:#a88a58}

/* SHOWCASE */
.showcase{height:680px;position:relative;display:flex;align-items:center;justify-content:center;text-align:center}
.showcase::after{content:"";position:absolute;inset:0;background:#0007}
.showcase img{position:absolute;inset:0}
.showcase-content{position:relative;z-index:1;padding:30px}
.showcase h2{font-size:clamp(55px,8vw,120px);margin:20px 0}

/* CONTACT */
.contact{text-align:center;padding:120px 8%}
.contact h2{margin:25px auto;max-width:750px}
.contact p{color:#aaa;margin-bottom:36px}

/* FOOTER */
footer{padding:55px 8% 30px;border-top:1px solid #ffffff20}
.footer-top{display:flex;justify-content:space-between;gap:30px;align-items:start}
.footer-links{display:flex;gap:30px;font-size:11px;letter-spacing:1px}
.footer-bottom{border-top:1px solid #ffffff20;margin-top:60px;padding-top:23px;display:flex;justify-content:space-between;gap:15px;font-size:10px;color:#888;letter-spacing:1px}

/* ANIMATIONS */
.reveal{opacity:0;transform:translateY(25px);transition:opacity .8s,transform .8s}
.reveal.visible{opacity:1;transform:translateY(0)}

@media(max-width:900px){
header{padding:25px 6%}
.logo{font-size:22px}
.menu-btn{display:block}
nav{display:none;position:absolute;top:82px;left:0;right:0;background:#101010;padding:35px;flex-direction:column;align-items:flex-start}
nav.open{display:flex}
.section{padding:75px 6%}
.hero{padding:0 6%}
.hero-bottom{left:6%;right:6%}
.collection-grid{grid-template-columns:1fr 1fr}
.collection-card .photo{height:350px}
.feature{grid-template-columns:1fr}
.feature-image{min-height:430px}
.feature-content{padding:75px 8%}
.showcase{height:500px}
}
@media(max-width:600px){
.hero h1{font-size:64px}
.hero-sub{font-size:10px}
.hero-bottom span:last-child{display:none}
.section-heading{display:block}
.collection-grid{grid-template-columns:1fr}
.collection-card .photo{height:400px}
.service{grid-template-columns:40px 1fr 20px;gap:10px}
.footer-top,.footer-bottom{flex-direction:column}
.footer-links{flex-wrap:wrap}
.contact{padding:90px 6%}
}
@media(prefers-reduced-motion:reduce){
html{scroll-behavior:auto}
.reveal{opacity:1;transform:none;transition:none}
}
</style>
</head>

<body>

